# 데이터베이스 설정 (로컬 PostgreSQL)
# 기본 연결 정보: 유저명=postgres, 비밀번호=postgres, 호스트=localhost, 포트=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/question_bank

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-sol
# 코드 답안은 저비용 모델로 먼저 채점하고, 애매한 경우에만 정밀 모델로 재채점합니다.
OPENAI_GRADING_MODEL=gpt-5.6-luna
OPENAI_GRADING_REVIEW_MODEL=gpt-5.6-sol
OPENAI_GRADING_CONFIDENCE_THRESHOLD=0.75

# Toss Payments
# 실제 키는 .env에만 저장하고 Git에 커밋하지 않습니다.
TOSS_SECRET_KEY=test_gsk_your_toss_secret_key_here
TOSS_API_BASE_URL=https://api.tosspayments.com
TOSS_API_TIMEOUT_SECONDS=15

# AI cost dashboard (KRW per 1,000,000 tokens; set for the model/provider in use)
AI_INPUT_COST_PER_MILLION_KRW=0
AI_OUTPUT_COST_PER_MILLION_KRW=0

# 서버 설정
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# JWT 인증 (운영 환경에서는 반드시 길고 무작위인 값으로 변경)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# admin 회원가입에 필요한 코드. 비워두면 공개 회원가입으로 admin 생성 불가
ADMIN_SIGNUP_CODE=your_admin_signup_code_here
# Vercel Cron 요청 검증용. 운영 환경에서는 16자 이상의 무작위 값으로 설정합니다.
CRON_SECRET=your_random_cron_secret_here

# 파일 업로드 설정
UPLOAD_DIR=uploads
PUBLIC_EXAM_DOCUMENT_STORAGE=local
PUBLIC_EXAM_DOCUMENT_DIR=uploads/public-exams
PUBLIC_EXAM_PDF_MAX_BYTES=4194304
# Vercel 배포에서는 Private Blob store를 연결하고 실제 토큰은 Vercel 환경변수에만 저장합니다.
BLOB_READ_WRITE_TOKEN=
MAX_FILE_SIZE=10485760

# CORS 설정 (프론트엔드 URL)
CORS_ORIGINS=["http://localhost:3000", "https://yourfrontend.vercel.app"]
