# 데이터베이스 설정 (로컬 PostgreSQL)
# 기본 연결 정보: 유저명=postgres, 비밀번호=postgres, 호스트=localhost, 포트=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/question_bank

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-sol
# 코드 답안은 저비용 모델로 먼저 채점하고, 애매한 경우에만 정밀 모델로 재채점합니다.
OPENAI_GRADING_MODEL=gpt-5.6-luna
OPENAI_GRADING_REVIEW_MODEL=gpt-5.6-sol
OPENAI_GRADING_CONFIDENCE_THRESHOLD=0.75

# 서버 설정
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# JWT 인증 (운영 환경에서는 반드시 길고 무작위인 값으로 변경)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# admin 회원가입에 필요한 코드. 비워두면 공개 회원가입으로 admin 생성 불가
ADMIN_SIGNUP_CODE=your_admin_signup_code_here

# 파일 업로드 설정
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# CORS 설정 (프론트엔드 URL)
CORS_ORIGINS=["http://localhost:3000", "https://yourfrontend.vercel.app"]
